<resources>
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F5F7FB</item>
        <item name="android:navigationBarColor">#172B4D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">#1769E8</item>
        <item name="colorSecondary">#16A6B2</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="DocNexaDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#172B4D</item>
        <item name="colorOnSurfaceVariant">#52627A</item>
        <item name="shapeAppearanceOverlay">@style/DocNexaDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DocNexaDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DocNexaDialogAction</item>
        <item name="buttonBarNegativeButtonStyle">@style/DocNexaDialogSecondaryAction</item>
        <item name="buttonBarNeutralButtonStyle">@style/DocNexaDialogSecondaryAction</item>
    </style>
    <style name="DocNexaDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
    <style name="DocNexaDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#172B4D</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="DocNexaDialogAction" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="backgroundTint">#2563EB</item>
        <item name="android:textColor">@color/dialog_action_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="DocNexaDialogSecondaryAction" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#2563EB</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
